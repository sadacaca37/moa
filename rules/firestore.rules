rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 주 선생님(관리자): 선생님 이메일(이메일/비밀번호 로그인). 공개 저장소에는 TEACHER_EMAIL로만 적고, 실제 이메일은 Firebase 콘솔의 규칙에만 있다. 모두 읽고 쓰기
    function teacher() {
      return request.auth != null
        && request.auth.token.email == 'TEACHER_EMAIL'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function signedIn() { return request.auth != null; }
    // 함께 쓰는 선생님: 주 선생님이 teachers/{이메일} 에 올린 계정 + 메일 인증 + 이메일·비밀번호 로그인
    //  - 자기가 만든 반(owner = 자기 uid)과 그 반의 학생·패들렛·문제만 다룬다
    //  - 주 선생님의 반에는 owner 칸이 없다 (예전 그대로)
    function tch() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/teachers/$(request.auth.token.email));
    }
    function myClass(cid) {
      return tch() && get(/databases/$(database)/documents/classes/$(cid)).data.get('owner', '') == request.auth.uid;
    }
    function myBoard(bid) {
      return tch() && get(/databases/$(database)/documents/boards/$(bid)).data.get('owner', '') == request.auth.uid;
    }
    // 반의 주인 선생님 uid (주 선생님 반·반 문서가 없는 반은 '')
    function classOwner(cid) {
      return exists(/databases/$(database)/documents/classes/$(cid))
        ? get(/databases/$(database)/documents/classes/$(cid)).data.get('owner', '')
        : '';
    }
    function okStudent(d) {
      return d.keys().hasOnly(['name', 'uid', 'score', 'outfit', 'created', 'seen', 'taja'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 10
        && d.score is int
        && (!('taja' in d) || (d.taja is map && d.taja.size() <= 12));
    }
    // 이 학생 기록을 지금 쓰는 기기(모아팡·타자팡에 마지막으로 들어온 기기)인지
    function owner(cid, key) {
      return signedIn() && get(/databases/$(database)/documents/classes/$(cid)/students/$(key)).data.uid == request.auth.uid;
    }
    match /{document=**} { allow read, write: if teacher(); }

    // 함께 쓰는 선생님 명단: 본인 것만 읽기 (올리고 지우기는 주 선생님만)
    match /teachers/{em} { allow get: if signedIn() && request.auth.token.email == em; }

    // 학생(익명 로그인)
    match /config/{d} {
      allow get: if signedIn();
      // 함께 쓰는 선생님의 첫 화면 링크(home_uid)·타자팡 설정·한 곳에서만 로그인 자리표(sess_uid) (자기 것만)
      allow write: if tch() && (d == 'home_' + request.auth.uid || d == 'taja_' + request.auth.uid || d == 'taja_approved_' + request.auth.uid || d == 'sess_' + request.auth.uid);
    }
    match /rooms/{code} {
      allow get: if signedIn();
      allow create: if tch() && request.resource.data.owner == request.auth.uid && myClass(request.resource.data.cid);
      allow update: if tch() && resource.data.get('owner', '') == request.auth.uid
        && request.resource.data.owner == request.auth.uid && myClass(request.resource.data.cid);
      allow delete: if tch() && resource.data.get('owner', '') == request.auth.uid;
    }
    match /banks/{k} {
      allow get: if signedIn();
      // 함께 쓰는 선생님의 문제 상자: banks/{uid}_ox 처럼 자기 uid로 시작하는 것만
      allow write: if tch() && k.matches(request.auth.uid + '_[a-z]+');
    }
    match /classes/{cid} {
      allow get: if signedIn();
      allow list: if tch() && resource.data.owner == request.auth.uid;
      allow create: if tch() && request.resource.data.owner == request.auth.uid;
      allow update: if tch() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if tch() && resource.data.owner == request.auth.uid;
      match /students/{key} {
        allow get: if signedIn();
        allow create: if signedIn() && okStudent(request.resource.data) && request.resource.data.score == 0;
        allow update: if signedIn() && okStudent(request.resource.data)
          && (request.resource.data.score == resource.data.score || request.resource.data.score == resource.data.score + 1);
        // 반 주인 선생님: 명단 보기, 점수 주기, 지우기
        allow read, write: if myClass(cid);
        // 타자팡 학습 자료 (포인트·연습 기록·진도) — 본인 기기만
        match /taja/{d} {
          allow get: if d == 'progress' && owner(cid, key);
          allow create, update: if d == 'progress' && owner(cid, key)
            && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
            && request.resource.data.json is string && request.resource.data.json.size() < 1000000
            && request.resource.data.updatedAt is int;
          allow read, write: if myClass(cid);
        }
      }
    }
    // 타자팡: 선생님께 보내는 오늘의 연습 보고 (확인 표시는 선생님만)
    //  - 지금은 주 선생님 반(owner 없는 반) 학생만 보낼 수 있다
    match /taja_reports/{rid} {
      allow get: if signedIn() && (resource == null || owner(resource.data.cid, resource.data.key));
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['id', 'userId', 'cid', 'key', 'name', 'grade', 'day', 'sentAt', 'checkedAt', 'note', 'summary'])
        && request.resource.data.checkedAt == 0
        && request.resource.data.userId == 'm_' + request.resource.data.cid + '_' + request.resource.data.key
        && rid == request.resource.data.userId + '_' + request.resource.data.day
        && request.resource.data.id == rid
        && request.resource.data.note is string && request.resource.data.note.size() <= 120
        && owner(request.resource.data.cid, request.resource.data.key)
        && classOwner(request.resource.data.cid) == '';
    }
    // 수업 보드(패들렛): 선생님이 '학생에게 보이기'로 연 것만 학생이 본다
    function boardPub(bid) {
      return get(/databases/$(database)/documents/boards/$(bid)).data.get('public', false) == true;
    }
    // 학생도 글·댓글을 쓸 수 있는 보드: 학생에게 보이고, 선생님이 '글쓰기 잠그기'를 하지 않은 것
    function boardOpen(bid) {
      let b = get(/databases/$(database)/documents/boards/$(bid)).data;
      return b.get('public', false) == true && b.get('lock', false) != true;
    }
    // 학생 글: 제목·내용·링크·사진(작게 줄인 그림, 750KB 아래)·파일 중 하나는 있어야 함
    //  files = 올린 파일 정보 목록(5개까지, 파일 내용은 files/ 아래), color = 카드 색
    function okPostBody(d) {
      return d.keys().hasOnly(['sec', 'title', 'body', 'link', 'img', 'author', 'uid', 'at', 'files', 'color'])
        && d.keys().hasAll(['sec', 'title', 'body', 'link', 'img', 'author', 'uid', 'at'])
        && d.sec is int && d.sec >= 0 && d.sec < 100
        && d.title is string && d.title.size() <= 80
        && d.body is string && d.body.size() <= 2000
        && d.link is string && d.link.size() <= 500
        && d.img is string && d.img.size() <= 750000
        && (d.img == '' || d.img.split(',')[0] in ['data:image/jpeg;base64', 'data:image/png;base64', 'data:image/webp;base64'])
        && (!('files' in d) || (d.files is list && d.files.size() <= 5))
        && (!('color' in d) || (d.color is string && d.color.size() <= 2))
        && ((d.title.size() + d.body.size() + d.link.size() + d.img.size()) > 0 || ('files' in d && d.files.size() > 0))
        && d.author is string && d.author.size() > 0 && d.author.size() <= 20
        && d.uid == request.auth.uid;
    }
    function okPost(d) { return okPostBody(d) && d.at == request.time; }
    function okComment(d) {
      return d.keys().hasOnly(['pid', 'body', 'author', 'uid', 'at'])
        && d.keys().hasAll(['pid', 'body', 'author', 'uid', 'at'])
        && d.pid is string && d.pid.size() > 0 && d.pid.size() <= 60
        && d.body is string && d.body.size() > 0 && d.body.size() <= 300
        && d.author is string && d.author.size() > 0 && d.author.size() <= 20
        && d.uid == request.auth.uid && d.at == request.time;
    }
    // 올린 파일 정보 (한 파일 10MB 아래, 900KB 조각 12개까지)
    function okFile(d) {
      return d.keys().hasOnly(['name', 'type', 'size', 'n', 'uid', 'at'])
        && d.keys().hasAll(['name', 'type', 'size', 'n', 'uid', 'at'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.type is string && d.type.size() <= 120
        && d.size is int && d.size > 0 && d.size <= 10485760
        && d.n is int && d.n >= 1 && d.n <= 12
        && d.uid == request.auth.uid && d.at == request.time;
    }
    function fileOf(bid, f) { return get(/databases/$(database)/documents/boards/$(bid)/files/$(f)).data; }
    // 이모티콘 반응: 문서 이름 = 글_uid_번호 (한 사람이 같은 이모티콘을 두 번 못 담)
    function okReact(r, d) {
      return d.keys().hasOnly(['pid', 'e', 'uid']) && d.keys().hasAll(['pid', 'e', 'uid'])
        && d.pid is string && d.pid.size() > 0 && d.pid.size() <= 60
        && d.e is int && ((d.e >= 0 && d.e < 8) || (d.e >= 100 && d.e < 300))
        && d.uid == request.auth.uid
        && r == d.pid + '_' + d.uid + '_' + string(d.e);
    }
    // 캔버스 메모 자리 (자기 글만)
    function okPos(bid, p, d) {
      return d.keys().hasOnly(['x', 'y', 'uid']) && d.keys().hasAll(['x', 'y', 'uid'])
        && d.x is number && d.y is number && d.x >= 0 && d.x <= 6000 && d.y >= 0 && d.y <= 6000
        && d.uid == request.auth.uid
        && get(/databases/$(database)/documents/boards/$(bid)/posts/$(p)).data.uid == request.auth.uid;
    }
    // 캔버스 메모 잇는 선
    function okLink(d) {
      return d.keys().hasOnly(['a', 'b', 'uid', 'at']) && d.keys().hasAll(['a', 'b', 'uid', 'at'])
        && d.a is string && d.a.size() > 0 && d.a.size() <= 60
        && d.b is string && d.b.size() > 0 && d.b.size() <= 60 && d.a != d.b
        && d.uid == request.auth.uid && d.at == request.time;
    }
    match /boards/{bid} {
      allow read: if signedIn() && resource.data.public == true;
      // 함께 쓰는 선생님: 자기 패들렛만
      allow read: if tch() && resource.data.owner == request.auth.uid;
      allow create: if tch() && request.resource.data.owner == request.auth.uid;
      allow update: if tch() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if tch() && (resource == null || resource.data.owner == request.auth.uid);
      // 학생이 올린 글·사진·파일 (자기 글만 고치기·지우기 · 선생님은 모두)
      match /posts/{p} {
        allow read: if signedIn() && boardPub(bid);
        allow create: if signedIn() && boardOpen(bid) && okPost(request.resource.data);
        // 자기 글 고치기 (쓴 사람·쓴 때는 그대로)
        allow update: if signedIn() && boardOpen(bid) && resource.data.uid == request.auth.uid
          && okPostBody(request.resource.data) && request.resource.data.at == resource.data.at
          && request.resource.data.author == resource.data.author;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow read, write: if myBoard(bid);
      }
      // 댓글 (글마다, 선생님 글·학생 글 모두에 달 수 있음)
      match /comments/{c} {
        allow read: if signedIn() && boardPub(bid);
        allow create: if signedIn() && boardOpen(bid) && okComment(request.resource.data);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow read, write: if myBoard(bid);
      }
      // 올린 파일: 정보 문서 + 조각(c/0..n-1). 올린 사람만 지우기 · 선생님은 모두
      match /files/{f} {
        allow read: if signedIn() && boardPub(bid);
        allow create: if signedIn() && boardOpen(bid) && okFile(request.resource.data);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow read, write: if myBoard(bid);
        match /c/{i} {
          allow read: if signedIn() && boardPub(bid);
          allow create: if signedIn() && boardOpen(bid) && fileOf(bid, f).uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['d']) && request.resource.data.d is bytes
            && request.resource.data.d.size() <= 900000
            && int(i) >= 0 && int(i) < fileOf(bid, f).n;
          allow delete: if signedIn() && fileOf(bid, f).uid == request.auth.uid;
          allow read, write: if myBoard(bid);
        }
      }
      // 이모티콘 반응
      match /reacts/{r} {
        allow read: if signedIn() && boardPub(bid);
        allow create: if signedIn() && boardOpen(bid) && okReact(r, request.resource.data);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow read, write: if myBoard(bid);
      }
      // 캔버스: 메모 자리(글 번호 = 문서 이름)와 메모 잇는 선
      match /pos/{p} {
        allow read: if signedIn() && boardPub(bid);
        allow create, update: if signedIn() && boardOpen(bid) && okPos(bid, p, request.resource.data);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow read, write: if myBoard(bid);
      }
      match /links/{l} {
        allow read: if signedIn() && boardPub(bid);
        allow create: if signedIn() && boardOpen(bid) && okLink(request.resource.data);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow read, write: if myBoard(bid);
      }
    }
    match /parts/{pid} {
      allow read: if signedIn() && resource.data.pub == true;
      allow read: if tch() && resource.data.owner == request.auth.uid;
      allow create: if tch() && request.resource.data.owner == request.auth.uid;
      allow update: if tch() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if tch() && (resource == null || resource.data.owner == request.auth.uid);
    }
  }
}
