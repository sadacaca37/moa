{
  "rules": {
    ".read": "auth != null && auth.token.email === 'TEACHER_EMAIL' && auth.provider === 'password'",
    ".write": "auth != null && auth.token.email === 'TEACHER_EMAIL' && auth.provider === 'password'",
    "teachers": {
      "$em": {
        ".read": "auth != null && auth.token.email != null && auth.token.email.toLowerCase().replace('.', ',') === $em"
      }
    },
    "owners": {
      "$cid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.provider === 'password' && auth.token.email_verified === true && root.child('teachers').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)"
      }
    },
    "live": {
      "$cid": {
        ".read": "auth != null && auth.provider === 'password' && auth.token.email_verified === true && root.child('teachers').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true && root.child('owners').child($cid).val() === auth.uid",
        ".write": "auth != null && auth.provider === 'password' && auth.token.email_verified === true && root.child('teachers').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true && root.child('owners').child($cid).val() === auth.uid",
        "state": {
          ".read": "auth != null"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['n', 'x', 'y']) && newData.child('n').isString() && newData.child('n').val().length <= 10"
          }
        },
        "chat": {
          ".read": "auth != null",
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid",
            ".validate": "newData.hasChildren(['u', 'n', 'm', 't']) && newData.child('m').isString() && newData.child('m').val().length <= 40 && newData.child('n').isString() && newData.child('n').val().length <= 10"
          }
        },
        "answers": {
          "$qid": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && !data.exists()"
            }
          }
        },
        "results": {
          "$run": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        }
      }
    },
    "taja": {
      "lb": {
        ".read": "auth != null",
        "$month": {
          ".validate": "$month.matches(/^20[0-9][0-9]-[01][0-9]$/)",
          "$who": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['userName', 'entries']) && newData.child('userName').isString() && newData.child('userName').val().length <= 30 && newData.child('entries').exists()",
            "entries": {
              "$i": {
                ".validate": "$i.matches(/^[012]$/) && newData.hasChildren(['id', 'userName', 'cpm'])",
                "cpm": {
                  ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1200"
                }
              }
            }
          }
        }
      },
      "lbMonths": {
        ".read": "auth != null",
        "$month": {
          ".write": "auth != null",
          ".validate": "newData.isBoolean() && $month.matches(/^20[0-9][0-9]-[01][0-9]$/)"
        }
      },
      "duo": {
        "$game": {
          "$room": {
            ".read": "auth != null && $game.matches(/^[a-z0-9_]{2,24}$/) && $room.matches(/^[0-9]{4}$/)",
            ".write": "auth != null && $game.matches(/^[a-z0-9_]{2,24}$/) && $room.matches(/^[0-9]{4}$/)"
          }
        }
      }
    }
  }
}
